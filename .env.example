# AI Workspace Bridge — copy to .env and fill in real values.
# NEVER commit real secrets.

APP_VERSION=20.0.0
APP_ENV=development
HOST=0.0.0.0
# Container/listen port (inside process). Host publish defaults to 8010 via compose.
PORT=8000
BRIDGE_HOST_PORT=8010
WEB_HOST_PORT=3010
BRIDGE_INTERNAL_URL=http://127.0.0.1:8010
DEBUG=false
# arq (needs rag-worker) | inline (asyncio in Bridge process)
RAG_INGEST_MODE=arq

# PostgreSQL (required)
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+asyncpg://aiws:change-me-db-password@127.0.0.1:55432/aiworkspace

# Redis (required)
REDIS_URL=redis://127.0.0.1:26379/0

# Auth — generate a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# First admin (created only when users table is empty)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password-min-10

# PC Worker must present this token on /ws/pc and /api/internal/embeddings
WORKER_TOKEN=change-me-worker-token

# Comma-separated browser origins (Next.js)
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://127.0.0.1:3000,http://127.0.0.1:3010

# Optional AES-256-GCM relay key between Bridge and Worker (NOT injected into browsers)
ENCRYPTION_KEY=change-me-32-byte-or-longer-key!!

# Default models (must match LM Studio ids)
DEFAULT_CHAT_MODEL=gemma-4-12b-agentic-fable5-composer2.5-v2-3.5x-tau2@q6_k
DEFAULT_EMBED_MODEL=text-embedding-embeddinggemma-300m
EMBED_DIM=768
RAG_CHUNK_CHARS=1800
RAG_CHUNK_OVERLAP=200
RAG_CONTEXT_CHARS=6000
RAG_HNSW_EF_SEARCH=40

# Rate limits & retention
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SEC=300
AUTH_MUTATION_RATE_LIMIT=20
AUTH_MUTATION_WINDOW_SEC=300
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SEC=300
AUDIT_RETENTION_DAYS=90
WORKER_HEARTBEAT_TTL_SEC=60
TRUST_PROXY_HEADERS=false

# Rotating file log (empty = stdout only)
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Cookie Secure flag (true behind HTTPS)
COOKIE_SECURE=false

# Local lab only: Bridge talks to LM Studio directly for embeddings.
# Leave empty in production so embeddings go through the PC Worker.
EMBED_DIRECT_URL=

