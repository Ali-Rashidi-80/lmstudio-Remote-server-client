# AI Workspace Bridge — copy to .env and fill in real values.
# NEVER commit real secrets.

APP_VERSION=20.0.0
HOST=0.0.0.0
# Container/listen port (inside process). Host publish defaults to 8010 via compose.
PORT=8000
BRIDGE_HOST_PORT=8010
DEBUG=false
# arq (needs rag-worker) | inline (asyncio in Bridge process)
RAG_INGEST_MODE=arq

# PostgreSQL (required)
DATABASE_URL=postgresql+asyncpg://aiws:change-me-db-password@localhost:55432/aiworkspace

# Redis (required)
REDIS_URL=redis://localhost:26379/0

# Auth — generate a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# First admin (created only when users table is empty)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password-min-10

# PC Worker must present this token on /ws/pc
WORKER_TOKEN=change-me-worker-token

# Comma-separated browser origins (Next.js)
CORS_ORIGINS=http://localhost:3000

# Optional AES relay key between Bridge and Worker (NOT injected into browsers)
ENCRYPTION_KEY=change-me-32-byte-or-longer-key!!

# Default models (must match LM Studio ids)
DEFAULT_CHAT_MODEL=gemma-4-12b-agentic-fable5-composer2.5-v2-3.5x-tau2@q6_k
DEFAULT_EMBED_MODEL=text-embedding-embeddinggemma-300m
EMBED_DIM=768

# Cookie Secure flag (true behind HTTPS)
COOKIE_SECURE=false

# Local lab only: Bridge talks to LM Studio directly for embeddings.
# Leave empty in production so embeddings go through the PC Worker.
EMBED_DIRECT_URL=

